{
  "manifest_version": 3,
  "name": "THU Auto Login",
  "version": "2.0.0",
  "description": "自动点击清华大学网络学堂和信息门户登录页的登录按钮、课程页面的“重新登录”链接",
  "permissions": ["scripting", "nativeMessaging"],
  "host_permissions": ["*://id.tsinghua.edu.cn/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://learn.tsinghua.edu.cn/*",
        "*://id.tsinghua.edu.cn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
